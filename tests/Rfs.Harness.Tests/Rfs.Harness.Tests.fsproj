<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ScenarioTests.fs" />
    <Compile Include="ServersTests.fs" />
    <Compile Include="../Rfs.Lsp.Tests/FakeServer.fs" Link="FakeServer.fs" />
    <Compile Include="MetricsTests.fs" />
    <Compile Include="RunnerTests.fs" />
    <Compile Include="ProjectSpecTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
