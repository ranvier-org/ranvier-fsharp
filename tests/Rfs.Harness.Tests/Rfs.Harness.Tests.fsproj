      <HintPath>$(FickleFcsDir)FSharp.Compiler.Service.dll</HintPath>
    </Reference>
    <PackageReference Include="Expecto" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Rfs.Harness\Rfs.Harness.fsproj" />
    <ProjectReference Include="..\..\src\Rfs.Projects\Rfs.Projects.fsproj" />
  </ItemGroup>
</Project>
