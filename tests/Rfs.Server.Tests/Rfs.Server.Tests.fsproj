    <Compile Include="CompletionTests.fs" />
    <Compile Include="CompletionGridTests.fs" />
    <Compile Include="CrossProjectTests.fs" />
    <Compile Include="DefinitionTests.fs" />
    <Compile Include="TokenGrid.fs" />
    <Compile Include="HoverGridTests.fs" />
    <Compile Include="LastStateGridTests.fs" />
    <Compile Include="DefinitionGridTexts.fs" />
