<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TestServer.fs" />
    <Compile Include="LifecycleTests.fs" />
    <Compile Include="WorkspaceTests.fs" />
    <Compile Include="PublishTests.fs" />
    <Compile Include="PublishFixTests.fs" />
    <Compile Include="HoverTests.fs" />
    <Compile Include="CrossProjectTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="FSharp.Compiler.Service">
      <HintPath>$(FickleFcsDir)FSharp.Compiler.Service.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Rfs.Lsp\Rfs.Lsp.fsproj" />
    <ProjectReference Include="..\..\src\Rfs.Harness\Rfs.Harness.fsproj" />
    <ProjectReference Include="..\..\src\Rfs.Server\Rfs.Server.fsproj" />
  </ItemGroup>
</Project>
