    <Compile Include="LifecycleTests.fs" />
    <Compile Include="WorkspaceTests.fs" />
    <Compile Include="PublishTests.fs" />
    <Compile Include="PublishFixTests.fs" />
    <Compile Include="ProgressTests.fs" />
