<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
    <FickleFcsDir>C:\Users\shaya\RiderProjects\fickle-fsharp\artifacts\bin\FSharp.Compiler.Service\Release\net10.0\</FickleFcsDir>
    <!-- The main Ranvier checkout next to this repo: master, with the lost wake-up fixes (#290, #303) merged. The graph needs both. -->
    <RanvierDir>$(MSBuildThisFileDirectory)..\Ranvier\src\Ranvier\</RanvierDir>
    <!-- Every project in the repo runs on the fork's FSharp.Core, so exactly one is loaded at runtime. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <!-- A solution build otherwise gives Ranvier, outside the solution, its default Configuration: a Debug Ranvier is a traced one, whose event log keeps every value it published alive -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>
  <ItemGroup>
    <!-- Overrides the FSharp.Core that packages like Ionide.ProjInfo and Expecto depend on, with no assets, so only the fork one is loaded. -->
    <PackageReference Include="FSharp.Core" ExcludeAssets="all" />
    <Reference Include="FSharp.Core">
      <HintPath>$(FickleFcsDir)FSharp.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
