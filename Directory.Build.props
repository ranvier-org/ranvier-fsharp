<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
    <FickleFcsDir Condition="'$(FickleFcsDir)' == ''">$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../fickle-fsharp/artifacts/bin/FSharp.Compiler.Service/Release/net10.0'))))</FickleFcsDir>
    <!-- Central Package Management pins FSharp.Core once in Directory.Packages.props rather than via SDK implicit version. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>

    <!-- Package and SourceLink metadata (individual library/tool projects opt in with IsPackable=true). -->
    <Version Condition="'$(Version)' == ''">0.1.0-preview.2</Version>
    <Authors>shayanhabibi</Authors>
    <Copyright>Copyright (c) 2026 Shayan Habibi</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ranvier-org/ranvier-fsharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ranvier-org/ranvier-fsharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <IncludeSymbols>false</IncludeSymbols>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Preview release of Ranvier.FSharp libraries and Ranvier.AutoComplete LSP server.</PackageReleaseNotes>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' and $(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <!--
    `RanvierTrace=true` selects the `Ranvier.Traced` NuGet package and compiles in the Trace.named labels of the checker's
    nodes and the answer to `rfs/why` (RANVIER_TRACE): Debug is traced, anything else selects `Ranvier`, and an explicit
    `-p:RanvierTrace=true` also switches traced-capable packages (`Ranvier.FSharp.Checker`, `Ranvier.FSharp.Server`) to `.Traced`.
  -->
  <PropertyGroup>
    <_RanvierTraceExplicit Condition="'$(RanvierTrace)' == 'true'">true</_RanvierTraceExplicit>
    <RanvierTrace Condition="'$(RanvierTrace)' == '' and ('$(Configuration)' == 'Debug' or '$(Configuration)' == '')">true</RanvierTrace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RanvierTrace)' == 'true'">
    <DefineConstants>$(DefineConstants);RANVIER_TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
