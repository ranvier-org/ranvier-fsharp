<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
    <FickleFcsDir>C:\Users\shaya\RiderProjects\fickle-fsharp\artifacts\bin\FSharp.Compiler.Service\Release\net10.0\</FickleFcsDir>
    <!-- Every project in the repo runs on the fork's FSharp.Core, so exactly one is loaded at runtime. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>
  <!--
    `RanvierTrace=true` selects the `Ranvier.Traced` NuGet package and compiles in the Trace.named labels of the checker's
    nodes and the answer to `rfs/why` (RANVIER_TRACE): Debug is traced, anything else selects `Ranvier`, and an explicit
    value wins. Configuration is still unset here when it is not passed, which builds as Debug.
  -->
  <PropertyGroup>
    <RanvierTrace Condition="'$(RanvierTrace)' == '' and ('$(Configuration)' == 'Debug' or '$(Configuration)' == '')">true</RanvierTrace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RanvierTrace)' == 'true'">
    <DefineConstants>$(DefineConstants);RANVIER_TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Overrides the FSharp.Core that packages like Ionide.ProjInfo and Expecto depend on, with no assets, so only the fork one is loaded. -->
    <PackageReference Include="FSharp.Core" ExcludeAssets="all" />
    <Reference Include="FSharp.Core">
      <HintPath>$(FickleFcsDir)FSharp.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
