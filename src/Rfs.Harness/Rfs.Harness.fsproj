<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rfs-harness</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Scenario.fs" />
    <Compile Include="Servers.fs" />
    <Compile Include="Metrics.fs" />
    <Compile Include="OracleClient.fs" />
    <Compile Include="CorpusCheck.fs" />
    <Compile Include="Runner.fs" />
    <Compile Include="Report.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rfs.Lsp\Rfs.Lsp.fsproj" />
    <!-- Not used from code: it brings the oracle executable and its dependencies into this project's output. -->
    <ProjectReference Include="..\Rfs.Oracle\Rfs.Oracle.fsproj" />
  </ItemGroup>
</Project>
