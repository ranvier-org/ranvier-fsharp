<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <Compile Include="GraphHost.fs" />
    <Compile Include="Request.fs" />
    <Compile Include="NameIndex.fs" />
    <Compile Include="FileDocs.fs" />
    <Compile Include="PositionMap.fs" />
    <Compile Include="FileDeps.fs" />
    <Compile Include="FileGraph.fs" />
    <Compile Include="FileUses.fs" />
    <Compile Include="FileLevel.fs" />
    <Compile Include="ProjectGraph.fs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rfs.Checker.Tests" />
    <InternalsVisibleTo Include="rfs-checkpoint" />
    <InternalsVisibleTo Include="Rfs.Server.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="FSharp.Compiler.Service">
      <HintPath>$(FickleFcsDir)FSharp.Compiler.Service.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ranvier" Condition="'$(RanvierTrace)' != 'true'" />
    <PackageReference Include="Ranvier.Traced" Condition="'$(RanvierTrace)' == 'true'" />
    <ProjectReference Include="..\Rfs.Projects\Rfs.Projects.fsproj" />
  </ItemGroup>
</Project>
