<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RanvierTracedPackage>true</RanvierTracedPackage>
    <PackageId>Ranvier.FSharp.Server</PackageId>
    <PackageId Condition="'$(_RanvierTraceExplicit)' == 'true'">Ranvier.FSharp.Server.Traced</PackageId>
    <Description>Embeddable F# Language Server Protocol (LSP) server and Ionide endpoint implementation powered by Ranvier.FSharp.Checker, built upon the Ionide ecosystem (FsAutoComplete, Ionide.LanguageServerProtocol, Ionide.ProjInfo).</Description>
    <Description Condition="'$(_RanvierTraceExplicit)' == 'true'">The traced build of Ranvier.FSharp.Server: the same assembly, namespaces, and version, with `rfs/why` causal graph inspection enabled, built upon the Ionide ecosystem. Depends on Ranvier.FSharp.Checker.Traced.</Description>
    <PackageTags>fsharp;lsp;language-server;ionide;ranvier;fsautocomplete</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Client.fs" />
    <Compile Include="Config.fs" />
    <Compile Include="Paths.fs" />
    <Compile Include="StackGuard.fs" />
    <Compile Include="Workspace.fs" />
    <Compile Include="Documents.fs" />
    <Compile Include="Outbox.fs" />
    <Compile Include="Publisher.fs" />
    <Compile Include="Progress.fs" />
    <Compile Include="Features/Hover.fs" />
    <Compile Include="Features/LastState.fs" />
    <Compile Include="Features/Completion.fs" />
    <Compile Include="Features/Definition.fs" />
    <Compile Include="Features/References.fs" />
    <Compile Include="Features/SignatureHelp.fs" />
    <Compile Include="Features/DocumentHighlight.fs" />
    <Compile Include="Features/Declaration.fs" />
    <Compile Include="Features/TypeDefinition.fs" />
    <Compile Include="Features/Implementation.fs" />
    <Compile Include="Features/SemanticTokens.fs" />
    <Compile Include="Features/Folding.fs" />
    <Compile Include="Features/SelectionRange.fs" />
    <Compile Include="Features/DocumentSymbols.fs" />
    <Compile Include="Features/WorkspaceSymbols.fs" />
    <Compile Include="Features/CallHierarchy.fs" />
    <Compile Include="Features/TypeHierarchy.fs" />
    <Compile Include="Features/Rename.fs" />
    <Compile Include="Features/InlayHints.fs" />
    <Compile Include="Features/CodeLens.fs" />
    <Compile Include="Features/InlineValue.fs" />
    <Compile Include="Features/IonideEndpoints.fs" />
    <Compile Include="Features/CodeActions.fs" />
    <Compile Include="Features/Formatting.fs" />
    <Compile Include="Features/Why.fs" />
    <Compile Include="Server.fs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ranvierautocomplete" />
    <InternalsVisibleTo Include="rfs" />
    <InternalsVisibleTo Include="Rfs.Server.Tests" />
    <InternalsVisibleTo Include="Rfs.Agent.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ionide.LanguageServerProtocol" />
    <!-- StreamJsonRpc brings an old StringTools next to the program, which the SDK's MSBuild (loaded in process to read projects) then fails on -->
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="FSharp.Compiler.Service">
      <HintPath>$(FickleFcsDir)FSharp.Compiler.Service.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rfs.Checker\Rfs.Checker.fsproj" PrivateAssets="none" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Ranvier.FSharp.Server.targets" Pack="true" PackagePath="build/$(PackageId).targets" Visible="false" />
    <None Include="Ranvier.FSharp.Server.targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" Visible="false" />
  </ItemGroup>
</Project>
