<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ranvierautocomplete</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Client.fs" />
    <Compile Include="Paths.fs" />
    <Compile Include="Workspace.fs" />
    <Compile Include="Documents.fs" />
    <Compile Include="Outbox.fs" />
    <Compile Include="Publisher.fs" />
    <Compile Include="Progress.fs" />
    <Compile Include="Features/Hover.fs" />
    <Compile Include="Features/Completion.fs" />
    <Compile Include="Features/Definition.fs" />
    <Compile Include="Features/References.fs" />
    <Compile Include="Features/Why.fs" />
    <Compile Include="Server.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rfs.Server.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ionide.LanguageServerProtocol" />
    <!-- Its StreamJsonRpc brings an old StringTools next to the program, which the SDK's MSBuild (loaded in process to read projects) then fails on -->
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="FSharp.Compiler.Service">
      <HintPath>$(FickleFcsDir)FSharp.Compiler.Service.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rfs.Checker\Rfs.Checker.fsproj" />
  </ItemGroup>
</Project>
