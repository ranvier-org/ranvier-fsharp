<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ranvierautocomplete</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ranvierautocomplete</ToolCommandName>
    <PackageId>Ranvier.AutoComplete</PackageId>
    <Version Condition="'$(ToolVersion)' != ''">$(ToolVersion)</Version>
    <Description>Demand-driven declaration-incremental F# language server CLI tool (`ranvierautocomplete`) powered by Ranvier and built on the Ionide ecosystem (FsAutoComplete, Ionide.LanguageServerProtocol, Ionide.ProjInfo).</Description>
    <PackageReleaseNotes>0.1.1 release of the Ranvier.AutoComplete F# LSP server CLI tool (ranvierautocomplete), built on Ranvier 0.2.0.</PackageReleaseNotes>
    <PackageTags>fsharp;lsp;language-server;ionide;ranvier;fsautocomplete;dotnet-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rfs.Server.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- StreamJsonRpc brings an old StringTools next to the program, which the SDK's MSBuild (loaded in process to read projects) then fails on -->
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rfs.Server\Rfs.Server.fsproj" />
  </ItemGroup>
</Project>
